<Steppable Type="UniformInitializer">
   
   <!-- Initial layout of cells in the form of rectangular slab --> 


   <Region>
      <BoxMin x="5" y="5" z="0"/>
      <BoxMax x="105" y="105" z="1"/>
      <Gap>5</Gap>
      <Width>10</Width>
      <Types>M1,M2</Types>
   </Region>
</Steppable>
</CompuCell3D>
