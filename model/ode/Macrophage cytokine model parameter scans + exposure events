{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1M5mFl9zQ_7lD2CrkNOMGrcYs4wOjbNEI","timestamp":1721943894202},{"file_id":"1sEcndFrnfFTFUCp6GXFY6SZmFEzd_MQl","timestamp":1721826542995},{"file_id":"1zg0hLl02O-EglKNrlegRMnebwWSbVwSJ","timestamp":1721742262899},{"file_id":"15Kr8bUEkuqi5WwF2i57Vb8fAKJ-KVS4A","timestamp":1721410168855}]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"coXGq-YHFYUx","collapsed":true},"outputs":[],"source":["!pip install tellurium"]},{"cell_type":"code","source":["pip install numpy==1.24.4"],"metadata":{"id":"QOCvqakgFxxL","collapsed":true},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Model predictions for various wood smoke exposure events\n","# Produces Figure 9\n","import tellurium as te\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import numpy as np\n","\n","# Define the model with continuous exposure\n","continuous_exposure_model = '''\n","  // Define species\n","  species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    Hm1 = 0.25; // Half-saturation constant for P\n","    Hm2 = 0.05; // Half-saturation constant for A\n","    Hm3 = 0.9; // Half-saturation constant for A inhibition function\n","    Hm4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + Hm1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + Hm2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + Hm2^n2)) * M1;\n","    J9: -> P; m6 * WS * (Hm4^n4 / (A^n4 + Hm4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M1;\n","\n","'''\n","\n","# Define the model with dosing events for one-time exposure\n","one_time_exposure_model = '''\n","  // Define species\n","  species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    Hm1 = 0.25; // Half-saturation constant for P\n","    Hm2 = 0.05; // Half-saturation constant for A\n","    Hm3 = 0.9; // Half-saturation constant for A inhibition function\n","    Hm4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + Hm1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + Hm2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + Hm2^n2)) * M1;\n","    J9: -> P; m6 * WS * (Hm4^n4 / (A^n4 + Hm4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M1;\n","\n","// Wood smoke dosing event\n","  E1: at (1 < time < 2): WS = 1.0;\n","  E2: at (time >= 2): WS = 0.0;\n","'''\n","\n","# Define the model with dosing events for recurring exposure\n","recurring_exposure_model = '''\n","  // Define species\n","  species M0, M1, M2, P, A;\n","\n","  // Define species\n","  species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    Hm1 = 0.25; // Half-saturation constant for P\n","    Hm2 = 0.05; // Half-saturation constant for A\n","    Hm3 = 0.9; // Half-saturation constant for A inhibition function\n","    Hm4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + Hm1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + Hm2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + Hm2^n2)) * M1;\n","    J9: -> P; m6 * WS * (Hm4^n4 / (A^n4 + Hm4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M1;\n","\n","  // Wood smoke recurring dosing events for 3 meals a day\n","  E1: at (time % 24 >= 8 and time % 24 < 9): WS = 1.0;\n","  E2: at (time % 24 >= 9 and time % 24 < 13): WS = 0.0;\n","  E3: at (time % 24 >= 13 and time % 24 < 14): WS = 1.0;\n","  E4: at (time % 24 >= 14 and time % 24 < 18): WS = 0.0;\n","  E5: at (time % 24 >= 18 and time % 24 < 19): WS = 1.0;\n","  E6: at (time % 24 >= 19 and time % 24 < 24): WS = 0.0;\n","'''\n","\n","# Function to simulate and plot a model\n","def simulate_and_plot(model_code, title, label_fontsize=14, tick_fontsize=12):\n","    r = te.loada(model_code)\n","    result = r.simulate(0, 73, 10000)\n","\n","    # Use a colorblind-friendly palette\n","    colors = sns.color_palette(\"colorblind\")\n","    line_styles = ['-', '--', '-.', ':']\n","\n","    plt.figure(figsize=(10, 6))\n","\n","     # LaTeX labels for species\n","    latex_labels = {\n","        'M0': r'$M0$',\n","        'M1': r'$M1$',\n","        'M2': r'$M2$',\n","        'P': r'$P$',\n","        'A': r'$A$'\n","    }\n","    for i, species in enumerate(['M0', 'M1', 'M2', 'P', 'A']):\n","        plt.plot(result[:,0], result[:,i+1], label=latex_labels[species], color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","\n","    plt.xlabel('Time (hours)', fontsize=label_fontsize)\n","    plt.ylabel('Concentration', fontsize=label_fontsize)\n","    plt.legend(fontsize=label_fontsize)\n","    plt.xticks(fontsize=tick_fontsize)\n","    plt.yticks(fontsize=tick_fontsize)\n","    # plt.title(title, fontsize=label_fontsize)\n","    # plt.ylim(0, 0.25)\n","    plt.xlim(0, 73)\n","\n","    plt.savefig(f'{title}.eps', format='eps')\n","    plt.savefig(f'{title}.eps', format='eps')\n","    plt.savefig(f'{title}.svg', format='svg')\n","    plt.show()\n","\n","# Simulate continuous exposure\n","simulate_and_plot(continuous_exposure_model, 'Wood Smoke Continuous Exposure Simulation')\n","\n","# Simulate and plot one-time exposure\n","simulate_and_plot(one_time_exposure_model, 'Wood Smoke One-Time Exposure Simulation')\n","\n","# Simulate and plot recurring exposure (3 meals a day)\n","simulate_and_plot(recurring_exposure_model, 'Wood Smoke Recurring Exposure Simulation (3 meals a day)')"],"metadata":{"id":"wxJ-3xAtxtzI"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["pip install SALib"],"metadata":{"id":"gg6ToV4__PHq","collapsed":true},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import tellurium as te\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import numpy as np\n","from SALib.sample import morris\n","from SALib.analyze import morris as morris_analyze\n","\n","r = te.loada('''\n","    // Define species\n","    species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    Hm1 = 0.25; // Half-saturation constant for P\n","    Hm2 = 0.05; // Half-saturation constant for A\n","    Hm3 = 0.9; // Half-saturation constant for A inhibition function\n","    Hm4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + Hm1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + Hm2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + Hm2^n2)) * M1;\n","    J9: -> P; m6 * WS * (Hm4^n4 / (A^n4 + Hm4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M1;\n","''')\n","\n","# Define the parameter ranges for sensitivity analysis\n","problem = {\n","    'num_vars': 18,\n","    'names': ['m1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8', 'm9', 'm10',\n","              'Hm1', 'Hm2', 'Hm3', 'Hm4', 'n1', 'n2', 'n3', 'n4'],\n","    'bounds': [[0.5, 10], [0.02, 2], [0.0058, 0.58], [0.0001, 0.01], [0.5, 10],\n","               [0.02, 2], [0.0001, 0.01], [0.013, 1.3], [0.005, 0.5], [0.01, 1.0],\n","               [0.05, 5], [0.05, 5], [0.05, 5], [0.05, 5],\n","               [1, 4], [1, 4], [1, 4], [1, 4]]\n","}\n","\n","# Generate samples\n","param_values = morris.sample(problem, N=1000, num_levels=4)\n","\n","# Define a function to run the model and return outputs of interest\n","def run_model(params):\n","    r.reset()\n","    (r['m1'], r['m2'], r['m3'], r['m4'], r['m5'], r['m6'], r['m7'], r['m8'],\n","     r['m9'], r['m10'], r['Hm1'], r['Hm2'], r['Hm3'], r['Hm4'],\n","     r['n1'], r['n2'], r['n3'], r['n4']) = params\n","    r['WS'] = 1.0\n","    result = r.simulate(0, 72, 2)\n","    return [result[-1, 2], result[-1, 3], result[-1, 4], result[-1, 5]] # M1, M2, P, A at t=72\n","\n","# Run the model for all parameter samples\n","Y = np.array([run_model(params) for params in param_values])\n","\n","# Perform the sensitivity analysis for each output separately\n","Si_list = []\n","for i in range(4):\n","    Si = morris_analyze.analyze(problem, param_values, Y[:, i], conf_level=0.95, print_to_console=True)\n","    Si_list.append(Si)\n","\n","# Plot the sensitivity results\n","fig, axes = plt.subplots(2, 2, figsize=(15, 15))\n","axes = axes.flatten()\n","\n","for ax, Si, title in zip(axes, Si_list, ['M1', 'M2', 'P', 'A']):\n","    ax.scatter(Si['mu_star'], Si['sigma'])\n","    for j, name in enumerate(problem['names']):\n","        ax.annotate(name, (Si['mu_star'][j], Si['sigma'][j]))\n","\n","    # Use LaTeX formatting for axis labels\n","    ax.set_xlabel(r'$\\mu^*$ (Parameter Importance)', fontsize=14)\n","    ax.set_ylabel(r'$\\sigma$ (Parameter Interactions)', fontsize=14)\n","    ax.set_title(f'Sensitivity Analysis for {title}', fontsize=14)\n","\n","    # Increase tick label size\n","    ax.tick_params(axis='both', labelsize=12)\n","\n","plt.tight_layout()\n","plt.savefig('sensitivity_analysis.eps')\n","plt.savefig('sensitivity_analysis.svg')\n","plt.show()\n","\n","# # Simulate the model\n","# result = r.simulate(0, 72, 1000)\n","\n","# # Extract simulation results\n","# time_sim = result[:, 0]\n","# M0_sim = result[:, 1]\n","# M1_sim = result[:, 2]\n","# M2_sim = result[:, 3]\n","# P_sim = result[:, 4]\n","# A_sim = result[:, 5]\n","\n","# # Normalize P_sim to compare with experimental data\n","# P_sim_normalized = P_sim / np.max(P_sim)\n","\n","# # Normalize A_sim to compare with experimental data\n","# A_sim_normalized = A_sim / np.max(A_sim)\n","\n","# # Use a colorblind-friendly palette\n","# colors = sns.color_palette(\"colorblind\")\n","\n","# # Define line styles\n","# line_styles = ['-', '--', '-.', ':', '-']\n","\n","\n","# # Create a figure with three subplots\n","# fig, (ax1, ax2, ax3) = plt.subplots(3, 1, figsize=(10, 18))\n","\n","# # Plot simulation results with colorblind palette and different line styles\n","# variables = [M0_sim, M1_sim, M2_sim, P_sim, A_sim]\n","# labels = ['$M0$', '$M1$', '$M2$',\n","#           '$P$', '$A$']\n","\n","# for i, (var, label, color, style) in enumerate(zip(variables, labels, colors, line_styles)):\n","#     ax1.plot(time_sim, var, label=label, color=color, linestyle=style)\n","\n","# ax1.set_xlabel('Time (hours)')\n","# ax1.set_ylabel('Normalized Concentration')\n","# ax1.set_title('Simulation Results')\n","# ax1.legend()\n","# ax1.grid(True)\n","# ax1.set_xlim(0, 72)\n","\n","# # Save the plot in both eps and SVG formats\n","# plt.savefig('Transients.eps', format='eps')\n","# plt.savefig('Transients.svg', format='svg')"],"metadata":{"id":"I_iBYyE_HHP8"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#M1-M2-cytokine subsystem parameter scan\n","# Figures 11 - 14\n","import tellurium as te\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# Define the updated macrophage-cytokine model\n","macrophage_cytokine_model = '''\n","    // Define species\n","    species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    Hm1 = 0.25; // Half-saturation constant for P\n","    Hm2 = 0.05; // Half-saturation constant for A\n","    Hm3 = 0.9; // Half-saturation constant for A inhibition function\n","    Hm4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + Hm1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + Hm2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + Hm2^n2)) * M1;\n","    J9: -> P; m6 * WS * (Hm4^n4 / (A^n4 + Hm4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (Hm3^n3 / (A^n3 + Hm3^n3)) * M1;\n","'''\n","\n","# Create a Tellurium model\n","r = te.loada(macrophage_cytokine_model)\n","\n","# Use a colorblind-friendly palette\n","colors = sns.color_palette(\"colorblind\")\n","\n","# Define line styles\n","line_styles = ['-', '--', '-.', ':']\n","\n","# Parameter scan for varying proliferation rate m3\n","m3_values = [0.029, 0.058, 0.116, 0.232]\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n","for i, m3 in enumerate(m3_values):\n","    r.resetAll()\n","    r.m3 = m3\n","    result = r.simulate(0, 72, 1000, ['time', 'M1', 'M2'])\n","    ax1.plot(result[:, 0], result[:, 1], label=f'$m_3={m3}$', color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","    ax2.plot(result[:, 0], result[:, 2], label=f'$m_3={m3}$', color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","\n","ax1.set_xlabel('Time (hours)', fontsize=14)\n","ax1.set_ylabel('M1 Concentration', fontsize=14)\n","ax1.legend(fontsize=10)\n","ax1.tick_params(axis='both', which='major', labelsize=12)\n","ax1.set_xlim(0, 72)\n","ax1.set_ylim(0, 0.3)\n","\n","ax2.set_xlabel('Time (hours)', fontsize=14)\n","ax2.set_ylabel('M2 Concentration', fontsize=14)\n","ax2.legend(fontsize=10)\n","ax2.tick_params(axis='both', which='major', labelsize=12)\n","ax2.set_xlim(0, 72)\n","ax2.set_ylim(0, 0.3)\n","\n","plt.tight_layout()\n","plt.savefig('Effects_of_Varying_Proliferation_Rate_m3.eps', format='eps')\n","plt.savefig('Effects_of_Varying_Proliferation_Rate_m3.svg', format='svg')\n","plt.show()\n","\n","# Parameter scan for varying cytokine production rate m6\n","m6_values = [0.1, 0.2, 0.4, 0.8]\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n","for i, m6 in enumerate(m6_values):\n","    r.resetAll()\n","    r.m6 = m6\n","    result = r.simulate(0, 72, 1000, ['time', 'M1', 'M2'])\n","    ax1.plot(result[:, 0], result[:, 1], label=f'$m_6={m6}$', color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","    ax2.plot(result[:, 0], result[:, 2], label=f'$m_6={m6}$', color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","\n","ax1.set_xlabel('Time (hours)', fontsize=14)\n","ax1.set_ylabel('M1 Concentration', fontsize=14)\n","ax1.legend(fontsize=10)\n","ax1.tick_params(axis='both', which='major', labelsize=12)\n","ax1.set_xlim(0, 72)\n","ax1.set_ylim(0, 0.3)\n","\n","ax2.set_xlabel('Time (hours)', fontsize=14)\n","ax2.set_ylabel('M2 Concentration', fontsize=14)\n","ax2.legend(fontsize=10)\n","ax2.tick_params(axis='both', which='major', labelsize=12)\n","ax2.set_xlim(0, 72)\n","ax2.set_ylim(0, 0.3)\n","\n","plt.tight_layout()\n","plt.savefig('Effects_of_Varying_Cytokine_Production_Rate_m6.eps', format='eps')\n","plt.savefig('Effects_of_Varying_Cytokine_Production_Rate_m6.svg', format='svg')\n","plt.show()\n","\n","# Parameter scan for varying cytokine production rate m8\n","m8_values = [0.065, 0.13, 0.26, 0.52]\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n","for i, m8 in enumerate(m8_values):\n","    r.resetAll()\n","    r.m8 = m8\n","    result = r.simulate(0, 72, 1000, ['time', 'M1', 'M2'])\n","    ax1.plot(result[:, 0], result[:, 1], label=f'$m_8={m8}$', color=colors[i % len(colors)], linestyle=line_styles[i % len(line_styles)])\n","    ax2.plot(result[:, 0], result[:, 2], label=f'$m_8={m8}$', color=colors[i % len(colors