{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1sEcndFrnfFTFUCp6GXFY6SZmFEzd_MQl","timestamp":1722007605795},{"file_id":"1zg0hLl02O-EglKNrlegRMnebwWSbVwSJ","timestamp":1721742262899},{"file_id":"15Kr8bUEkuqi5WwF2i57Vb8fAKJ-KVS4A","timestamp":1721410168855}]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"coXGq-YHFYUx","collapsed":true},"outputs":[],"source":["!pip install tellurium"]},{"cell_type":"code","source":["pip install numpy==1.24.4"],"metadata":{"id":"QOCvqakgFxxL","collapsed":true},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#M1-M2-cytokine subsystem versus experimental data\n","# Figure 15\n","import tellurium as te\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import numpy as np\n","\n","r = te.loada('''\n","    // Define species\n","    species M0, M1, M2, P, A;\n","\n","    // Define parameters\n","    m1 = 50; // M0 to M1 differentiation rate\n","    m2 = 0.1; // M0 to M2 differentiation rate\n","    m3 = 0.07; // Proliferation rate of M1 and M2 with carrying capacity\n","    m4 = 0.001; // Natural death rate of M0, M1, and M2\n","    m5 = 0.05; // M1 to M2 transition rate\n","    m6 = 0.2; // Production rate of pro-inflammatory cytokine P\n","    m7 = 0.04; // Degradation rate of P\n","    m8 = 0.1; // Production rate of anti-inflammatory cytokine A by M2\n","    m9 = 0.04; // Degradation rate of A\n","    m10 = 0.1; // Production rate of A by M1\n","    h1 = 0.25; // Half-saturation constant for P\n","    h2 = 0.05; // Half-saturation constant for A\n","    h3 = 0.9; // Half-saturation constant for A inhibition function\n","    h4 = 1.2; // Half-saturation constant for A inhibition of P production\n","    n1 = 2.5; // Hill coefficient for P production\n","    n2 = 4; // Hill coefficient for A production\n","    n3 = 2; // Hill coefficient for A inhibition of P production\n","    n4 = 2; // Hill coefficient for A inhibition\n","\n","    WS = 1.0; // Wood smoke exposure level\n","    K = 1.0; // Carrying capacity for M1 and M2\n","\n","    // Initial conditions\n","    M0 = 0.07;\n","    M1 = 0.07;\n","    M2 = 0.07;\n","    P = 0.001;\n","    A = 0.001;\n","\n","    // Equations with non-negativity constraints\n","    J1: M0 -> M1; m1 * (P^n1 / (P^n1 + h1^n1)) * M0;\n","    J2: M0 -> M2; m2 * (A^n2 / (A^n2 + h2^n2)) * M0;\n","    J3: M1 -> M0; m3 * M1 * (1 - (M0 + M1 + M2) / K);\n","    J4: M2 -> M0; m3 * M2 * (1 - (M0 + M1 + M2) / K);\n","    J5: M0 -> ; m4 * M0;\n","    J6: M1 -> ; m4 * M1;\n","    J7: M2 -> ; m4 * M2;\n","    J8: M1 -> M2; m5 * (A^n2 / (A^n2 + h2^n2)) * M1;\n","    J9: -> P; m6 * WS * (h4^n4 / (A^n4 + h4^n4)) * M1;\n","    J10: P -> ; m7 * P;\n","    J11: -> A; m8 * (h3^n3 / (A^n3 + h3^n3)) * M2;\n","    J12: A -> ; m9 * A;\n","    J13: -> A; m10 * (h3^n3 / (A^n3 + h3^n3)) * M1;\n","    ''')\n","\n","# Experimental Data\n","time_exp = np.array([24, 48, 72])\n","A_exp = np.array([0.8929, 0.9157, 1])\n","P_exp = np.array([0.8522, 0.9831, 1])\n","\n","# Simulate the model\n","result = r.simulate(0, 73, 1000)\n","\n","# Extract simulation results\n","time_sim = result[:, 0]\n","M0_sim = result[:, 1]\n","M1_sim = result[:, 2]\n","M2_sim = result[:, 3]\n","P_sim = result[:, 4]\n","A_sim = result[:, 5]\n","\n","# Normalize P_sim to compare with experimental data\n","P_sim_normalized = P_sim / np.max(P_sim)\n","\n","# Normalize A_sim to compare with experimental data\n","A_sim_normalized = A_sim / np.max(A_sim)\n","\n","# Use a colorblind-friendly palette\n","colors = sns.color_palette(\"colorblind\")\n","\n","# Define line styles\n","line_styles = ['-', '--', '-.', ':', '-']\n","\n","\n","# Create first figure for transients\n","fig1 = plt.figure(figsize=(10, 6))\n","ax1 = fig1.add_subplot(111)\n","\n","# Plot simulation results with colorblind palette and different line styles\n","variables = [M0_sim, M1_sim, M2_sim, P_sim, A_sim]\n","labels = ['$M0$', '$M1$', '$M2$', '$P$', '$A$']\n","\n","for i, (var, label, color, style) in enumerate(zip(variables, labels, colors, line_styles)):\n","    ax1.plot(time_sim, var, label=label, color=color, linestyle=style)\n","\n","ax1.set_xlabel('Time (hours)', fontsize=14)\n","ax1.set_ylabel('Normalized Concentration', fontsize=14)\n","ax1.legend(fontsize=12)\n","ax1.grid(True)\n","ax1.set_xlim(0, 72)\n","ax1.tick_params(axis='both', which='major', labelsize=12)\n","\n","plt.tight_layout()\n","fig1.savefig('Transients.eps', format='eps')\n","fig1.savefig('Transients.png', format='png')\n","fig1.savefig('Transients.svg', format='svg')\n","\n","# Create second figure for P fit\n","fig2 = plt.figure(figsize=(10, 6))\n","ax2 = fig2.add_subplot(111)\n","\n","ax2.scatter(time_exp, P_exp, color=colors[0], label='Experimental P')\n","ax2.plot(time_sim, P_sim_normalized, color=colors[1], label='Simulated P (normalized)')\n","ax2.set_xlabel('Time (hours)', fontsize=14)\n","ax2.set_ylabel('Normalized Concentration', fontsize=14)\n","ax2.legend(fontsize=12)\n","ax2.grid(True)\n","ax2.set_xlim(0, 73)\n","ax2.tick_params(axis='both', which='major', labelsize=12)\n","\n","plt.tight_layout()\n","fig2.savefig('P_fit.eps', format='eps')\n","fig2.savefig('P_fit.png', format='png')\n","fig2.savefig('P_fit.svg', format='svg')\n","\n","# Create third figure for A fit\n","fig3 = plt.figure(figsize=(10, 6))\n","ax3 = fig3.add_subplot(111)\n","\n","ax3.scatter(time_exp, A_exp, color=colors[2], label='Experimental A')\n","ax3.plot(time_sim, A_sim_normalized, color=colors[3], label='Simulated A (normalized)')\n","ax3.set_xlabel('Time (hours)', fontsize=14)\n","ax3.set_ylabel('Normalized Concentration', fontsize=14)\n","ax3.legend(fontsize=12)\n","ax3.grid(True)\n","ax3.set_xlim(0, 73)\n","ax3.tick_params(axis='both', which='major', labelsize=12)\n","\n","plt.tight_layout()\n","fig3.savefig('A_fit.eps', format='eps')\n","fig3.savefig('A_fit.png', format='png')\n","fig3.savefig('A_fit.svg', format='svg')\n","\n","plt.show()\n"],"metadata":{"id":"I1L_ka88V-Ct"},"execution_count":null,"outputs":[]}]}